# SteamCMD + game server binaries (re-created by scripts/install.ps1)
/server/
/steamcmd/

# Everything under instances/ is the host's own server: name, password, admins, rotation, cups, logs, roles/bans.
# It is created from defaults/instance on first run (scripts/setup.ps1) and never shipped or committed.
/instances/

# Hand-made safety copy of an instance (see docs/distribution-plan.md); not part of the project
/.personal-backup/

# Local secrets / overrides (password.local, steam-user.local, ...)
*.local
.env

# Output of scripts/package.ps1
/dist/
