# SteamCMD + game server binaries (re-created by scripts/install.ps1)
/server/
/steamcmd/

# Runtime output inside each instance's save dir
instances/*/logs/
instances/*/*.log
instances/*/*.tmp
instances/*/~Lock
instances/*/telemetry/

# Generated each start from server_config.template.scnf + password.local
instances/*/server_config.scnf

# Generated each start from default_loop.template.becl + settings.json
instances/*/default_loop.becl

# Generated each start from server_cup_config.template.ccnl + cups\*.becl (the game reads these, from the save folder)
instances/*/server_cup_config.ccnl
instances/*/cups-generated/

# Local secrets / overrides
*.local
.env

# Runtime roles/bans (created from server_privilege.template.sprv + admins.local)
instances/*/server_privilege.sprv

# Safety copies made by hand while recovering files; not part of the project
instances/*/cups-backup/
